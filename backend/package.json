  "description": "Production-grade AI Chatbot Backend with Express, MongoDB, and Gemini AI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
